rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model (prototype)
    // ===============================================================
    //
    // All operational documents live below workspaces/{workspaceId} and
    // contain workspaceId. Patient-operational documents additionally carry
    // denormalized teamId and locationId so Firestore can enforce staff scope.
    // Empty member teamIds/locationIds mean no patient-record access for every
    // role except tenant_admin.
    //
    // workspaces/{workspaceId}
    //   id: string (required, equal to workspaceId)
    //   status: "active" for client access
    //
    // workspaces/{workspaceId}/members/{uid} (server-managed authority)
    //   id, uid, workspaceId: strings (required; id and uid equal document id)
    //   role: approved role string (required)
    //   status: "active" for access
    //   teamIds, locationIds: lists of scoped identifiers (required, max 50)
    //
    // Patient-operational collections (contacts, consentRecords,
    // conversations, messages, internalNotes, appointments and automationRuns)
    // require workspaceId, teamId and
    // locationId. Direct client mutation is denied except the explicitly
    // enumerated synthetic-only tenant-admin contact-preference surface below.
    // Appointment requests and internal notes are backend-authored through
    // purpose-bound audited callables; browsers retain scoped metadata reads.
    //
    // contacts/{contactId} is the staff-readable minimum contact model:
    //   id, workspaceId, teamId, locationId: string (required, immutable)
    //   maskedPhone, displayLabel: bounded masked/synthetic labels (immutable)
    //   suppression: bounded backend-authored policy state (immutable)
    //   preferredLanguage: "en" | "si" | "ta" (required, mutable)
    //   alternateLanguages: unique language list, max 2 (required, mutable)
    //   tags: unique approved operational-label list, max 6 (required, mutable)
    //   synthetic: true for this client mutation (required, immutable)
    //   preferenceRevision: int 0..1,000,000,000 (required, +1 per update)
    //   updatedAt: timestamp (required, request.time per update)
    //   no protected identifier or external patient reference is permitted
    //
    // contactSecrets/{contactId} stores server-only protected identifiers:
    //   phoneLookupHmac, encryptedPhoneRef, encryptedDisplayNameRef and
    //   externalPatientRef. Every direct client read and write is denied.
    //
    // templates/{versionId} and flows/{versionId} are singular-language,
    // synthetic SafeNet-demo catalogue versions. Local lifecycle is separate
    // from provider submission/approval evidence. Provider IDs are null and
    // provider state is unverified/not_submitted until a trusted backend sync
    // supplies evidence. Direct browser writes are denied so clients cannot
    // forge approval, alter released metadata or transfer demo ownership.
    //
    // appointments/{appointmentId} and appointmentEvents/{eventId} expose only
    // scoped, bounded patient-workflow metadata reads to clients. Every direct
    // create, update and delete is denied. The audited appointment callable is
    // the sole mutation boundary and uses Admin SDK transactions, optimistic
    // revision checks, immutable events, idempotency and durable audit evidence.
    //
    // labReports and labReportEvents contain strict staff-safe operational
    // workflow metadata only. They do not contain a report body, result value,
    // diagnosis, interpretation, raw attachment, access token, external report
    // reference, notification fingerprint or protected handoff reference.
    // labReportSecrets/{labReportId} and labReportEventSecrets/{eventId} hold
    // those protected references/fingerprints for trusted server use only.
    // Every direct client read/write of either secret collection is denied;
    // every client mutation of staff-safe laboratory state is also denied.
    //
    // idempotencyKeys/{id} is backend-owned replay evidence. Every direct
    // client read/write is denied.
    //
    // campaigns, audienceSnapshots, campaignEvents and campaignCheckpoints are
    // strict governed read models for tenant admins, campaign operators,
    // campaign approvers and analysts. Every mutation is server-only. The
    // synthetic campaign is simulation-only, stores no recipient/patient list,
    // and binds approval to its audience, templates, purpose and schedule by a
    // canonical SHA-256 digest validated by trusted backend code.
    //
    // whatsappConnections and integrations expose only the frozen synthetic
    // demo-v1 staff projections to an active tenant administrator. The single
    // WhatsApp record and two integration records use exact identities,
    // literal mock/blocked state, native timestamps and zero external/network
    // gates. Raw provider identifiers, endpoints, credentials, secret-manager
    // references and free-form health details are not valid staff fields.
    // whatsappConnectionSecrets and integrationSecrets remain wholly
    // Admin-SDK-only, and every direct connection mutation is denied.
    //
    // AI/knowledge governance exposes only five fixed staff-safe knowledge
    // documents, three fixed effective selections, four retrospective run
    // records and four matching one-shot events in the SafeNet synthetic demo.
    // Every collection list and direct write is denied. Authorized MFA-backed
    // staff fetch only fixed paths; a missing fixed path is observable as
    // missing, while an existing document must satisfy its complete v1 schema
    // and frozen scenario matrix. Protected content, fixture references and
    // fingerprints remain in client-denied secret collections. No handoff
    // document, model/provider call, dispatch or patient-state mutation is
    // represented by this read surface.
    //
    // auditEvents, consentRecords, audienceSnapshots, campaignRecipients,
    // provider state, usage data and every global collection are server-only
    // for writes. Audit and consent history are append-only from the Admin SDK.
    // Admin SDK operations bypass Rules and therefore require separate backend
    // authorization, schema validation and audit controls.
    //
    // Timestamps stored in Firestore are native timestamp values, not date
    // strings. Every client-writable string/list/map is strictly bounded.
    // ===============================================================

    // ===============================================================
    // Common authentication and tenant helpers
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function validId(value) {
      return value is string && value.size() >= 1 && value.size() <= 128;
    }

    function validStrictId(value) {
      return validId(value) &&
        value.matches('^[A-Za-z0-9][A-Za-z0-9._:-]*$');
    }

    function validBoundedString(value, minLength, maxLength) {
      return value is string &&
        value.size() >= minLength &&
        value.size() <= maxLength;
    }

    function memberExists(workspaceId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function memberData(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
    }

    function workspaceIsActive(workspaceId) {
      let workspace = get(
        /databases/$(database)/documents/workspaces/$(workspaceId)
      ).data;
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        workspace.id == workspaceId &&
        workspace.status == 'active';
    }

    function workspaceAllowsSyntheticClientMutations(workspaceId) {
      let workspace = get(
        /databases/$(database)/documents/workspaces/$(workspaceId)
      ).data;
      return workspace.id == workspaceId &&
        workspace.status == 'active' &&
        workspace.mode in ['local', 'demo'] &&
        workspace.dataClassification == 'synthetic_only';
    }

    function activeWorkspaceMember(workspaceId) {
      let member = memberData(workspaceId);
      return memberExists(workspaceId) &&
        workspaceIsActive(workspaceId) &&
        member.id == request.auth.uid &&
        member.uid == request.auth.uid &&
        member.workspaceId == workspaceId &&
        member.status == 'active' &&
        member.role in [
          'platform_owner',
          'tenant_admin',
          'supervisor',
          'agent',
          'campaign_operator',
          'campaign_approver',
          'analyst',
          'privacy_reviewer',
          'clinical_approver'
        ] &&
        member.teamIds is list &&
        member.teamIds.size() <= 50 &&
        member.locationIds is list &&
        member.locationIds.size() <= 50;
    }

    function hasRole(workspaceId, allowedRoles) {
      let member = memberData(workspaceId);
      return activeWorkspaceMember(workspaceId) &&
        member.role in allowedRoles;
    }

    function canReadTemplateCatalogue(workspaceId) {
      return hasRole(workspaceId, [
        'tenant_admin',
        'supervisor',
        'agent',
        'campaign_operator',
        'campaign_approver'
      ]);
    }

    function isSameWorkspace(data, workspaceId) {
      return data is map &&
        data.workspaceId is string &&
        data.workspaceId == workspaceId;
    }

    function hasValidPatientScope(data) {
      return data is map &&
        data.keys().hasAll(['teamId', 'locationId']) &&
        validId(data.teamId) &&
        validId(data.locationId);
    }

    function canReadScopedPatientData(workspaceId, data) {
      return activeWorkspaceMember(workspaceId) &&
        isSameWorkspace(data, workspaceId) &&
        hasValidPatientScope(data) &&
        (
          memberData(workspaceId).role == 'tenant_admin' ||
          (
            memberData(workspaceId).role in ['supervisor', 'agent', 'clinical_approver'] &&
            memberData(workspaceId).teamIds.size() > 0 &&
            memberData(workspaceId).locationIds.size() > 0 &&
            data.teamId in memberData(workspaceId).teamIds &&
            data.locationId in memberData(workspaceId).locationIds
          )
        );
    }

    function isBoundedList() {
      return request.query.limit <= 100;
    }

    // Collection paths already fix workspaceId. Tenant admins may list a
    // bounded tenant collection; operational roles must issue queries whose
    // exact teamId and locationId constraints prove every result is in scope.
    function canListScopedPatientData(workspaceId, data) {
      return activeWorkspaceMember(workspaceId) &&
        isBoundedList() &&
        (
          memberData(workspaceId).role == 'tenant_admin' ||
          (
            memberData(workspaceId).role in ['supervisor', 'agent', 'clinical_approver'] &&
            memberData(workspaceId).teamIds.size() > 0 &&
            memberData(workspaceId).locationIds.size() > 0 &&
            data.teamId in memberData(workspaceId).teamIds &&
            data.locationId in memberData(workspaceId).locationIds
          )
        );
    }

    function canReadConsentData(workspaceId, data) {
      return isSameWorkspace(data, workspaceId) &&
        (
          hasRole(workspaceId, ['tenant_admin', 'privacy_reviewer', 'campaign_approver']) ||
          canReadScopedPatientData(workspaceId, data)
        );
    }

    // Consent history is immutable but still queryable for an authorized
    // contact view. Privileged governance roles receive a bounded tenant
    // query; patient-operation roles must prove the exact team/location scope
    // in the query just like contacts, conversations and messages.
    function canListConsentData(workspaceId, data) {
      return activeWorkspaceMember(workspaceId) &&
        isBoundedList() &&
        (
          memberData(workspaceId).role in [
            'tenant_admin',
            'privacy_reviewer',
            'campaign_approver'
          ] ||
          (
            memberData(workspaceId).role in ['supervisor', 'agent', 'clinical_approver'] &&
            memberData(workspaceId).teamIds.size() > 0 &&
            memberData(workspaceId).locationIds.size() > 0 &&
            data.teamId in memberData(workspaceId).teamIds &&
            data.locationId in memberData(workspaceId).locationIds
          )
        );
    }

    function canReadCampaignData(workspaceId, data) {
      return isSameWorkspace(data, workspaceId) &&
        hasRole(workspaceId, [
          'tenant_admin',
          'campaign_operator',
          'campaign_approver',
          'analyst'
        ]);
    }

    function canListCampaignData(workspaceId) {
      return activeWorkspaceMember(workspaceId) &&
        isBoundedList() &&
        memberData(workspaceId).role in [
          'tenant_admin',
          'campaign_operator',
          'campaign_approver',
          'analyst'
        ];
    }

    // ===============================================================
    // Client-writable domain validators
    // ===============================================================
    function validContactLanguages(data) {
      return data.preferredLanguage in ['en', 'si', 'ta'] &&
        data.alternateLanguages is list &&
        data.alternateLanguages.size() <= 2 &&
        data.alternateLanguages.hasOnly(['en', 'si', 'ta']) &&
        data.alternateLanguages.toSet().size() == data.alternateLanguages.size() &&
        !(data.preferredLanguage in data.alternateLanguages);
    }

    function validContactTags(tags) {
      return tags is list &&
        tags.size() <= 6 &&
        tags.hasOnly([
          'appointment',
          'laboratory',
          'package',
          'human-handoff',
          'urgent-simulation',
          'marketing-suppressed'
        ]) &&
        tags.toSet().size() == tags.size();
    }

    function validContactSuppression(suppression) {
      return suppression is map &&
        suppression.keys().hasAll([
          'suppressAll',
          'suppressMarketing',
          'invalidContact',
          'reasons',
          'updatedAt'
        ]) &&
        suppression.keys().hasOnly([
          'suppressAll',
          'suppressMarketing',
          'invalidContact',
          'reasons',
          'updatedAt'
        ]) &&
        suppression.suppressAll is bool &&
        suppression.suppressMarketing is bool &&
        suppression.invalidContact is bool &&
        suppression.reasons is list &&
        suppression.reasons.size() <= 6 &&
        suppression.reasons.hasOnly([
          'stop_keyword',
          'manual_withdrawal',
          'complaint',
          'invalid_number',
          'guardian_authority_missing',
          'clinical_hold'
        ]) &&
        suppression.reasons.toSet().size() == suppression.reasons.size() &&
        suppression.updatedAt is timestamp;
    }

    function isValidStaffContactReadModel(data, workspaceId) {
      return data is map &&
        data.keys().hasAll([
          'id',
          'workspaceId',
          'teamId',
          'locationId',
          'maskedPhone',
          'displayLabel',
          'preferredLanguage',
          'alternateLanguages',
          'suppression',
          'tags',
          'synthetic',
          'preferenceRevision',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'teamId',
          'locationId',
          'maskedPhone',
          'displayLabel',
          'preferredLanguage',
          'alternateLanguages',
          'suppression',
          'tags',
          'synthetic',
          'preferenceRevision',
          'createdAt',
          'updatedAt'
        ]) &&
        validStrictId(data.id) &&
        data.workspaceId == workspaceId &&
        validStrictId(data.teamId) &&
        validStrictId(data.locationId) &&
        validBoundedString(data.maskedPhone, 1, 160) &&
        validBoundedString(data.displayLabel, 1, 160) &&
        validContactLanguages(data) &&
        validContactSuppression(data.suppression) &&
        validContactTags(data.tags) &&
        data.synthetic is bool &&
        data.preferenceRevision is int &&
        data.preferenceRevision >= 0 &&
        data.preferenceRevision <= 1000000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSyntheticContactPreferenceState(data, workspaceId, contactId) {
      return isValidStaffContactReadModel(data, workspaceId) &&
        data.id == contactId &&
        data.synthetic == true;
    }

    // Existing contact identity, consent/suppression and routing fields are
    // backend-authored. diff() below makes them immutable to this client path,
    // while this validator checks every client-writable preference field.

    function validContactPreferenceTransition() {
      return resource.data.synthetic == true &&
        request.resource.data.synthetic == true &&
        resource.data.preferenceRevision is int &&
        request.resource.data.preferenceRevision == resource.data.preferenceRevision + 1 &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'preferredLanguage',
          'alternateLanguages',
          'tags',
          'preferenceRevision',
          'updatedAt'
        ]);
    }

    function validLabWorkflowStatus(value) {
      return value in [
        'registered',
        'processing',
        'ready',
        'notification_queued',
        'notification_simulated',
        'notification_sent',
        'accessed',
        'expired',
        'superseded'
      ];
    }

    function validStaffSafeLabAccess(data) {
      return data is map &&
        data.keys().size() == 3 &&
        data.keys().hasOnly(['mode', 'available', 'expiresAt']) &&
        (
          (
            data.mode == 'simulator_handoff' &&
            data.available == true &&
            data.expiresAt is timestamp
          ) ||
          (
            data.mode == 'not_available' &&
            data.available == false &&
            data.expiresAt == null
          )
        );
    }

    function isValidStaffSafeLabReport(data, workspaceId, labReportId) {
      return data is map &&
        data.keys().size() == 17 &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'conversationId',
          'contactId',
          'teamId',
          'locationId',
          'workflowStatus',
          'collectedAt',
          'readyAt',
          'secureAccess',
          'lastNotificationAt',
          'authoritativeSystem',
          'revision',
          'synthetic',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == labReportId &&
        validStrictId(data.id) &&
        data.workspaceId == workspaceId &&
        validStrictId(data.conversationId) &&
        validStrictId(data.contactId) &&
        validStrictId(data.teamId) &&
        validStrictId(data.locationId) &&
        validLabWorkflowStatus(data.workflowStatus) &&
        (data.collectedAt == null || data.collectedAt is timestamp) &&
        (data.readyAt == null || data.readyAt is timestamp) &&
        validStaffSafeLabAccess(data.secureAccess) &&
        (data.lastNotificationAt == null || data.lastNotificationAt is timestamp) &&
        data.authoritativeSystem == 'simulator' &&
        data.revision is int &&
        data.revision >= 0 &&
        data.revision <= 1000000000 &&
        data.synthetic == true &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffSafeLabReportEvent(data, workspaceId, eventId) {
      return data is map &&
        data.keys().size() == 15 &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'labReportId',
          'conversationId',
          'contactId',
          'teamId',
          'locationId',
          'eventType',
          'fromStatus',
          'toStatus',
          'source',
          'synthetic',
          'schemaVersion',
          'occurredAt',
          'createdAt'
        ]) &&
        data.id == eventId &&
        validStrictId(data.id) &&
        data.workspaceId == workspaceId &&
        validStrictId(data.labReportId) &&
        validStrictId(data.conversationId) &&
        validStrictId(data.contactId) &&
        validStrictId(data.teamId) &&
        validStrictId(data.locationId) &&
        data.eventType in [
          'simulator_report_ready',
          'notification_queued',
          'notification_simulated',
          'secure_accessed',
          'secure_access_expired'
        ] &&
        (data.fromStatus == null || validLabWorkflowStatus(data.fromStatus)) &&
        validLabWorkflowStatus(data.toStatus) &&
        data.source in ['simulator_seed', 'trusted_backend'] &&
        data.synthetic == true &&
        data.schemaVersion == 1 &&
        data.occurredAt is timestamp &&
        data.createdAt is timestamp;
    }

    function validCampaignState(value) {
      return value in [
        'draft',
        'audience_building',
        'compliance_review',
        'approval_pending',
        'scheduled',
        'dispatching',
        'paused',
        'completed',
        'cancelled',
        'failed'
      ];
    }

    function validCampaignTemplateVersions(data) {
      return data is map &&
        data.keys().size() == 3 &&
        data.keys().hasOnly(['en', 'si', 'ta']) &&
        validStrictId(data.en) &&
        validStrictId(data.si) &&
        validStrictId(data.ta) &&
        data.en.matches('^template_[a-z][a-z0-9_]*_en_v[1-9][0-9]*$') &&
        data.si.matches('^template_[a-z][a-z0-9_]*_si_v[1-9][0-9]*$') &&
        data.ta.matches('^template_[a-z][a-z0-9_]*_ta_v[1-9][0-9]*$') &&
        data.en != data.si &&
        data.en != data.ta &&
        data.si != data.ta;
    }

    function validCampaignQuietHours(data) {
      return data is map &&
        data.keys().size() == 2 &&
        data.keys().hasOnly(['startsAtLocal', 'endsAtLocal']) &&
        data.startsAtLocal is string &&
        data.startsAtLocal.size() == 5 &&
        data.startsAtLocal.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.endsAtLocal is string &&
        data.endsAtLocal.size() == 5 &&
        data.endsAtLocal.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validCampaignSchedule(data) {
      return data is map &&
        data.keys().size() == 3 &&
        data.keys().hasOnly(['startsAt', 'timeZone', 'quietHours']) &&
        data.startsAt is timestamp &&
        data.timeZone == 'Asia/Colombo' &&
        validCampaignQuietHours(data.quietHours);
    }

    function validSimulationCampaignApproval(data) {
      return data is map &&
        data.keys().size() == 6 &&
        data.keys().hasOnly([
          'required',
          'status',
          'scope',
          'approverId',
          'reviewedAt',
          'approvedContentHash'
        ]) &&
        data.required == true &&
        data.status == 'approved' &&
        data.scope == 'simulation_only' &&
        validStrictId(data.approverId) &&
        data.reviewedAt is timestamp &&
        data.approvedContentHash is string &&
        data.approvedContentHash.matches('^[0-9a-f]{64}$');
    }

    function isValidGovernedCampaign(data, workspaceId, campaignId) {
      return data is map &&
        data.keys().size() == 26 &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'name',
          'purpose',
          'messageCategory',
          'targetAction',
          'ownerId',
          'templateVersionIds',
          'audienceSnapshotId',
          'state',
          'dispatchMode',
          'schedule',
          'approval',
          'revision',
          'canaryStatus',
          'processedEligible',
          'scanOffset',
          'nextBatchIndex',
          'batchSize',
          'lastCheckpointId',
          'externalCalls',
          'networkCalls',
          'synthetic',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == campaignId &&
        validStrictId(data.id) &&
        data.workspaceId == workspaceId &&
        validBoundedString(data.name, 1, 160) &&
        data.purpose in ['health_campaigns', 'event_campaigns'] &&
        data.messageCategory == 'marketing' &&
        validBoundedString(data.targetAction, 1, 240) &&
        validStrictId(data.ownerId) &&
        validCampaignTemplateVersions(data.templateVersionIds) &&
        validStrictId(data.audienceSnapshotId) &&
        validCampaignState(data.state) &&
        data.dispatchMode == 'simulation' &&
        validCampaignSchedule(data.schedule) &&
        validSimulationCampaignApproval(data.approval) &&
        data.ownerId != data.approval.approverId &&
        data.revision is int &&
        data.revision >= 0 &&
        data.revision <= 1000000000 &&
        data.canaryStatus in ['not_run', 'passed_simulation', 'failed'] &&
        data.processedEligible is int &&
        data.processedEligible >= 0 &&
        data.processedEligible <= 50000 &&
        data.scanOffset is int &&
        data.scanOffset >= data.processedEligible &&
        data.scanOffset <= 50000 &&
        data.nextBatchIndex is int &&
        data.nextBatchIndex >= 0 &&
        data.nextBatchIndex <= 50 &&
        data.batchSize == 1000 &&
        data.nextBatchIndex * data.batchSize >= data.processedEligible &&
        (
          (data.nextBatchIndex == 0 && data.processedEligible == 0) ||
          (
            data.nextBatchIndex > 0 &&
            (data.nextBatchIndex - 1) * data.batchSize < data.processedEligible
          )
        ) &&
        (data.lastCheckpointId == null || validStrictId(data.lastCheckpointId)) &&
        (
          data.lastCheckpointId != null ||
          (
            data.processedEligible == 0 &&
            data.scanOffset == 0 &&
            data.nextBatchIndex == 0
          )
        ) &&
        (data.state != 'scheduled' || data.lastCheckpointId == null) &&
        (data.state != 'completed' || data.lastCheckpointId != null) &&
        data.externalCalls == 0 &&
        data.networkCalls == 0 &&
        data.synthetic == true &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validCampaignLanguageCounts(data, maximum) {
      return data is map &&
        data.keys().size() == 3 &&
        data.keys().hasOnly(['en', 'si', 'ta']) &&
        data.en is int && data.en >= 0 && data.en <= maximum &&
        data.si is int && data.si >= 0 && data.si <= maximum &&
        data.ta is int && data.ta >= 0 && data.ta <= maximum;
    }

    function validCampaignExclusionCounts(data) {
      return data is map &&
        data.keys().size() == 6 &&
        data.keys().hasOnly([
          'frequency_cap',
          'consent_missing',
          'suppressed',
          'duplicate',
          'invalid_contact',
          'language_unavailable'
        ]) &&
        data.frequency_cap is int && data.frequency_cap >= 0 && data.frequency_cap <= 50000 &&
        data.consent_missing is int && data.consent_missing >= 0 && data.consent_missing <= 50000 &&
        data.suppressed is int && data.suppressed >= 0 && data.suppressed <= 50000 &&
        data.duplicate is int && data.duplicate >= 0 && data.duplicate <= 50000 &&
        data.invalid_contact is int && data.invalid_contact >= 0 && data.invalid_contact <= 50000 &&
        data.language_unavailable is int && data.language_unavailable >= 0 && data.language_unavailable <= 50000;
    }

    function isValidAudienceSnapshot(data, workspaceId, snapshotId) {
      return data is map &&
        data.keys().size() == 17 &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'campaignId',
          'criteriaSummary',
          'totalEvaluated',
          'eligibleCount',
          'excludedCount',
          'unknownConsentCount',
          'exclusionsByReason',
          'languageCounts',
          'contentHash',
          'immutable',
          'synthetic',
          'schemaVersion',
          'finalizedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == snapshotId &&
        validStrictId(data.id) &&
        data.workspaceId == workspaceId &&
        validStrictId(data.campaignId) &&
        validBoundedString(data.criteriaSummary, 1, 500) &&
        data.totalEvaluated is int &&
        data.totalEvaluated >= 1 &&
        data.totalEvaluated <= 50000 &&
        data.eligibleCount is int && data.eligibleCount >= 0 &&
        data.excludedCount is int && data.excludedCount >= 0 &&
        data.unknownConsentCount is int && data.unknownConsentCount >= 0 &&
        data.eligibleCount + data.excludedCount == data.totalEvaluated &&
        validCampaignExclusionCounts(data.exclusionsByReason) &&
        data.exclusionsByReason.frequency_cap +
          data.exclusionsByReason.consent_missing +
          data.exclusionsByReason.suppressed +
          data.exclusionsByReason.duplicate +
          data.exclusionsByReason.invalid_contact +
          data.exclusionsByReason.language_unavailable == data.excludedCount &&
        data.unknownConsentCount == data.exclusionsByReason.consent_missing &&
        validCampaignLanguageCounts(data.languageCounts, 50000) &&
        data.languageCounts.en + data.languageCounts.si + data.languageCounts.ta ==
          data.totalEvaluated &&
        data.contentHash is string && data.contentHash.matches('^[0-9a-f]{64}$') &&
        data.immutable == true &&
        data.synthetic == true &&
        data.schemaVersion == 1 &&
        data.finalizedAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validCampaignEventTransition(data) {
      return (
          data.action == 'run_canary' &&
          data.fromState == 'scheduled' &&
          data.toState == 'scheduled'
        ) || (
          data.action == 'start' &&
          data.fromState == 'scheduled' &&
          data.toState == 'dispatching'
        ) || (
          data.action == 'advance_batch' &&
          data.fromState == 'dispatching' &&
          data.toState in ['dispatching', 'completed'] &&
          validStrictId(data.checkpointId) &&
          data.checkpointId.matches(
            '^' + data.campaignId + ':checkpoint:[0-9]{6}$'
          )
        ) || (
          data.action == 'pause' &&
          data.fromState == 'dispatching' &&
          data.toState == 'paused'
        ) || (
          data.action == 'resume' &&
          data.fromState == 'paused' &&
          data.toState == 'dispatching'
        ) || (
          data.action == 'inject_fault' &&
          data.fromState == 'dispatching' &&
          data.toState == 'failed'
        ) || (
          data.action == 'retry' &&
          data.fromState == 'failed' &&
          data.toState == 'dispatching'
        ) || (
          data.action == 'cancel' &&
          data.fromState in ['scheduled', 'dispatching', 'paused', 'failed'] &&
          data.toState == 'cancelled'
        );
    }

    function validCampaignCheckpointIdentity(checkpointId, campaignId, batchIndex) {
      let checkpointParts = checkpointId.split(':checkpoint:');
      return checkpointParts.size() == 2 &&
        checkpointParts[0] == campaignId &&
        checkpointParts[1].matches('^[0-9]{6}$') &&
        (
          (batchIndex == 0 && checkpointParts[1] == '000000') ||
          (
            batchIndex > 0 &&
            checkpointParts[1].replace('^0+', '') == string(batchIndex)
          )
        );
    }

    function isValidCampaignEvent(data, workspaceId, eventId) {
      return data is map &&
        data.keys().size() == 14 &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'campaignId',
          'actorUid',
          'action',
          'fromState',
          'toState',
          'revision',
          'checkpointId',
          'externalCalls',
          'networkCalls',
          'synthetic',
          'schemaVersion',
          'createdAt'
        ]) &&
        data.id == eventId &&
        validStrictId(data.id) &&
        data.workspaceId == workspaceId &&
        validStrictId(data.campaignId) &&
        validStrictId(data.actorUid) &&
        data.action in [
          'run_canary',
          'start',
          'advance_batch',
          'pause',
          'resume',
          'inject_fault',
          'retry',
          'cancel'
        ] &&
        validCampaignState(data.fromState) &&
        validCampaignState(data.toState) &&
        data.revision is int && data.revision >= 1 && data.revision <= 1000000000 &&
        (data.checkpointId == null || validStrictId(data.checkpointId)) &&
        validCampaignEventTransition(data) &&
        (data.action == 'advance_batch' || data.checkpointId == null) &&
        data.externalCalls == 0 &&
        data.networkCalls == 0 &&
        data.synthetic == true &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp;
    }

    function isValidCampaignCheckpoint(data, workspaceId, checkpointId) {
      return data is map &&
        data.keys().size() == 17 &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'campaignId',
          'eventId',
          'batchIndex',
          'sourceOffsetStart',
          'sourceOffsetEnd',
          'eligibleCount',
          'languageCounts',
          'processedEligible',
          'scanComplete',
          'digest',
          'externalCalls',
          'networkCalls',
          'synthetic',
          'schemaVersion',
          'createdAt'
        ]) &&
        data.id == checkpointId &&
        validStrictId(data.id) &&
        data.workspaceId == workspaceId &&
        validStrictId(data.campaignId) &&
        validStrictId(data.eventId) &&
        data.batchIndex is int && data.batchIndex >= 0 && data.batchIndex <= 49 &&
        validCampaignCheckpointIdentity(data.id, data.campaignId, data.batchIndex) &&
        data.sourceOffsetStart is int &&
        data.sourceOffsetStart >= 0 && data.sourceOffsetStart <= 49999 &&
        data.sourceOffsetEnd is int &&
        data.sourceOffsetEnd > data.sourceOffsetStart && data.sourceOffsetEnd <= 50000 &&
        data.eligibleCount is int && data.eligibleCount >= 1 && data.eligibleCount <= 1000 &&
        validCampaignLanguageCounts(data.languageCounts, 1000) &&
        data.languageCounts.en + data.languageCounts.si + data.languageCounts.ta ==
          data.eligibleCount &&
        data.processedEligible is int &&
        data.processedEligible >= data.eligibleCount &&
        data.processedEligible <= data.sourceOffsetEnd &&
        data.scanComplete is bool &&
        data.scanComplete == (data.sourceOffsetEnd == 50000) &&
        (data.scanComplete || data.eligibleCount == 1000) &&
        data.processedEligible > data.batchIndex * 1000 &&
        data.processedEligible <= (data.batchIndex + 1) * 1000 &&
        (data.scanComplete || data.processedEligible == (data.batchIndex + 1) * 1000) &&
        data.digest is string && data.digest.matches('^[0-9a-f]{64}$') &&
        data.externalCalls == 0 &&
        data.networkCalls == 0 &&
        data.synthetic == true &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp;
    }

    function validTemplateProviderState(data) {
      return data is map &&
        data.keys().size() == 6 &&
        data.keys().hasOnly([
          'submissionState',
          'approvalState',
          'authority',
          'assetId',
          'qualityRating',
          'checkedAt'
        ]) &&
        data.submissionState in ['not_submitted', 'submitted'] &&
        data.approvalState in [
          'unverified',
          'pending',
          'approved',
          'paused',
          'disabled',
          'rejected'
        ] &&
        data.authority in ['none', 'meta'] &&
        (data.assetId == null || validBoundedString(data.assetId, 1, 160)) &&
        data.qualityRating in ['unknown', 'high', 'medium', 'low'] &&
        (data.checkedAt == null || data.checkedAt is timestamp) &&
        (
          (
            data.submissionState == 'not_submitted' &&
            data.approvalState == 'unverified' &&
            data.authority == 'none' &&
            data.assetId == null &&
            data.qualityRating == 'unknown' &&
            data.checkedAt == null
          ) ||
          (
            data.submissionState == 'submitted' &&
            data.approvalState != 'unverified' &&
            data.authority == 'meta' &&
            validBoundedString(data.assetId, 1, 160) &&
            data.checkedAt is timestamp
          )
        );
    }

    function validTemplateOwnership(data, workspaceId) {
      return data is map &&
        data.keys().size() == 5 &&
        data.keys().hasOnly([
          'ownerKind',
          'ownerWorkspaceId',
          'transferableToHemas',
          'productionUseAllowed',
          'notice'
        ]) &&
        data.ownerKind == 'safenet_demo' &&
        data.ownerWorkspaceId == workspaceId &&
        data.transferableToHemas == false &&
        data.productionUseAllowed == false &&
        data.notice ==
          'SafeNet demo asset. It is not a Hemas-owned or transferable production asset.';
    }

    function validTemplateComponent(data) {
      return data is map &&
        (
          (
            data.kind == 'header' &&
            data.keys().size() == 3 &&
            data.keys().hasOnly(['kind', 'format', 'text']) &&
            data.format == 'text' &&
            validBoundedString(data.text, 1, 240)
          ) ||
          (
            data.kind == 'body' &&
            data.keys().size() == 2 &&
            data.keys().hasOnly(['kind', 'text']) &&
            validBoundedString(data.text, 1, 2048)
          ) ||
          (
            data.kind == 'footer' &&
            data.keys().size() == 2 &&
            data.keys().hasOnly(['kind', 'text']) &&
            validBoundedString(data.text, 1, 240)
          ) ||
          (
            data.kind == 'buttons' &&
            data.keys().size() == 2 &&
            data.keys().hasOnly(['kind', 'buttons']) &&
            data.buttons is list &&
            data.buttons.size() >= 1 &&
            data.buttons.size() <= 10
          )
        );
    }

    function validTemplateVariableRule(data) {
      return data is map &&
        data.keys().size() == 6 &&
        data.keys().hasOnly([
          'key',
          'description',
          'required',
          'maxLength',
          'exampleValue',
          'allowedPattern'
        ]) &&
        data.key is string &&
        data.key.matches('^[a-z][a-z0-9_]{0,63}$') &&
        validBoundedString(data.description, 1, 240) &&
        data.required is bool &&
        data.maxLength is int && data.maxLength >= 1 && data.maxLength <= 500 &&
        validBoundedString(data.exampleValue, 1, 500) &&
        (data.allowedPattern == null || validBoundedString(data.allowedPattern, 1, 240));
    }

    function isValidTemplateCatalogueItem(data, workspaceId, templateId) {
      return data is map &&
        data.keys().size() == 19 &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'assetKey',
          'sortKey',
          'providerName',
          'category',
          'language',
          'version',
          'localState',
          'providerState',
          'immutable',
          'contentHash',
          'components',
          'variableRules',
          'ownership',
          'synthetic',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == templateId &&
        validStrictId(data.id) &&
        data.workspaceId == workspaceId &&
        data.assetKey is string &&
        data.assetKey.matches('^[a-z][a-z0-9_]*$') &&
        validBoundedString(data.sortKey, 1, 260) &&
        data.providerName is string &&
        data.providerName.matches('^[a-z][a-z0-9_]*$') &&
        data.category in ['utility', 'marketing', 'authentication'] &&
        data.language in ['en', 'si', 'ta'] &&
        data.version is int && data.version >= 1 && data.version <= 10000 &&
        data.localState in ['draft', 'submitted', 'approved', 'paused', 'disabled', 'rejected'] &&
        validTemplateProviderState(data.providerState) &&
        data.immutable is bool &&
        data.immutable == (data.localState != 'draft') &&
        data.contentHash is string && data.contentHash.matches('^[0-9a-f]{64}$') &&
        data.components is list &&
        data.components.size() >= 1 && data.components.size() <= 8 &&
        data.variableRules is list && data.variableRules.size() <= 20 &&
        validTemplateOwnership(data.ownership, workspaceId) &&
        data.synthetic == true &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isFixedCampaignTemplateId(templateId) {
      return templateId in [
        'template_wellness_awareness_en_v3',
        'template_wellness_awareness_si_v3',
        'template_wellness_awareness_ta_v3'
      ];
    }

    function isValidAnalystCampaignTemplate(data, workspaceId, templateId) {
      return isFixedCampaignTemplateId(templateId) &&
        data is map &&
        data.keys().size() == 19 &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'assetKey',
          'sortKey',
          'providerName',
          'category',
          'language',
          'version',
          'localState',
          'providerState',
          'immutable',
          'contentHash',
          'components',
          'variableRules',
          'ownership',
          'synthetic',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == templateId &&
        data.workspaceId == workspaceId &&
        data.assetKey == 'wellness_awareness' &&
        data.providerName == 'wellness_awareness' &&
        data.category == 'marketing' &&
        data.version == 3 &&
        data.localState == 'approved' &&
        data.immutable == true &&
        data.contentHash is string &&
        data.contentHash.matches('^[0-9a-f]{64}$') &&
        data.providerState is map &&
        data.providerState.keys().size() == 6 &&
        data.providerState.keys().hasOnly([
          'submissionState',
          'approvalState',
          'authority',
          'assetId',
          'qualityRating',
          'checkedAt'
        ]) &&
        data.providerState.submissionState == 'not_submitted' &&
        data.providerState.approvalState == 'unverified' &&
        data.providerState.authority == 'none' &&
        data.providerState.assetId == null &&
        data.providerState.qualityRating == 'unknown' &&
        data.providerState.checkedAt == null &&
        data.ownership is map &&
        data.ownership.keys().size() == 5 &&
        data.ownership.keys().hasOnly([
          'ownerKind',
          'ownerWorkspaceId',
          'transferableToHemas',
          'productionUseAllowed',
          'notice'
        ]) &&
        data.ownership.ownerKind == 'safenet_demo' &&
        data.ownership.ownerWorkspaceId == workspaceId &&
        data.ownership.transferableToHemas == false &&
        data.ownership.productionUseAllowed == false &&
        (
          (
            templateId == 'template_wellness_awareness_en_v3' &&
            data.language == 'en' &&
            data.sortKey == 'wellness_awareness:en:0003'
          ) || (
            templateId == 'template_wellness_awareness_si_v3' &&
            data.language == 'si' &&
            data.sortKey == 'wellness_awareness:si:0003'
          ) || (
            templateId == 'template_wellness_awareness_ta_v3' &&
            data.language == 'ta' &&
            data.sortKey == 'wellness_awareness:ta:0003'
          )
        ) &&
        data.synthetic == true &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function canGetTemplateCatalogueItem(data, workspaceId, templateId) {
      let member = memberData(workspaceId);
      return activeWorkspaceMember(workspaceId) &&
        (
          (
            member.role in [
              'tenant_admin',
              'supervisor',
              'agent',
              'campaign_operator',
              'campaign_approver'
            ] &&
            data is map &&
            data.id == templateId &&
            data.workspaceId == workspaceId
          ) || (
            member.role == 'analyst' &&
            isValidAnalystCampaignTemplate(data, workspaceId, templateId)
          )
        );
    }

    // ===============================================================
    // Phase 5 automation and clinical-care read-model helpers
    // ===============================================================
    function validSha256(value) {
      return value is string && value.matches('^[0-9a-f]{64}$');
    }

    function validNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function validPhase5Identity(data, workspaceId, documentId) {
      return data is map &&
        data.id == documentId &&
        validStrictId(data.id) &&
        data.workspaceId == workspaceId;
    }

    function validPhase5SafeProjection(data) {
      return data.schemaVersion == 1 &&
        data.synthetic == true &&
        data.externalDispatchCount == 0 &&
        data.networkCallCount == 0;
    }

    function validPhase5Revision(value) {
      return value is int && value >= 1 && value <= 1000000;
    }

    function validGovernedActor(actor) {
      return actor is map &&
        actor.keys().size() == 2 &&
        actor.keys().hasOnly(['actorKind', 'actorUid']) &&
        validGovernedActorFields(actor.actorKind, actor.actorUid);
    }

    function validGovernedActorFields(actorKind, actorUid) {
      return (
          (actorKind == 'system' && actorUid == null) ||
          (actorKind == 'staff' && validStrictId(actorUid))
        );
    }

    function canReadAutomationCatalogue(workspaceId) {
      return hasRole(workspaceId, ['tenant_admin', 'supervisor', 'analyst']);
    }

    function canReadCareCatalogue(workspaceId) {
      return hasRole(workspaceId, ['tenant_admin', 'analyst', 'clinical_approver']);
    }

    function canListAutomationCatalogue(workspaceId, data) {
      return canReadAutomationCatalogue(workspaceId) &&
        isBoundedList() &&
        data.family in ['appointment_service', 'laboratory_service'];
    }

    function canListCareCatalogue(workspaceId, data) {
      return canReadCareCatalogue(workspaceId) &&
        isBoundedList() &&
        data.family == 'post_discharge';
    }

    function canReadAutomationExecution(workspaceId, data) {
      let member = memberData(workspaceId);
      return activeWorkspaceMember(workspaceId) &&
        isSameWorkspace(data, workspaceId) &&
        hasValidPatientScope(data) &&
        (
          (
            member.role == 'tenant_admin' &&
            (
              member.scopeMode == 'workspace_wide' ||
              (
                member.scopeMode == 'assigned' &&
                member.teamIds.size() > 0 && member.locationIds.size() > 0 &&
                data.teamId in member.teamIds && data.locationId in member.locationIds
              )
            )
          ) ||
          (
            member.role == 'supervisor' &&
            member.teamIds.size() > 0 &&
            member.locationIds.size() > 0 &&
            data.teamId in member.teamIds &&
            data.locationId in member.locationIds
          )
        );
    }

    function canReadCareExecution(workspaceId, data) {
      let member = memberData(workspaceId);
      return activeWorkspaceMember(workspaceId) &&
        isSameWorkspace(data, workspaceId) &&
        hasValidPatientScope(data) &&
        (
          (
            member.role == 'tenant_admin' &&
            (
              member.scopeMode == 'workspace_wide' ||
              (
                member.scopeMode == 'assigned' &&
                member.teamIds.size() > 0 && member.locationIds.size() > 0 &&
                data.teamId in member.teamIds && data.locationId in member.locationIds
              )
            )
          ) ||
          (
            member.role == 'clinical_approver' &&
            member.teamIds.size() > 0 &&
            member.locationIds.size() > 0 &&
            data.teamId in member.teamIds &&
            data.locationId in member.locationIds
          )
        );
    }

    function validAutomationDefinition(data, workspaceId, definitionId) {
      return data.keys().size() == 21 &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'family', 'version', 'name', 'trigger',
          'consentPurpose', 'riskLevel', 'steps', 'contentHash',
          'secretBindingHash', 'ownerUid', 'approverUid', 'approvalHash',
          'approvalScope', 'approvedAt', 'lifecycleState', 'schemaVersion',
          'synthetic', 'createdAt', 'updatedAt'
        ]) &&
        validPhase5Identity(data, workspaceId, definitionId) &&
        data.family in ['appointment_service', 'laboratory_service'] &&
        data.version is int && data.version >= 1 && data.version <= 1000000 &&
        validBoundedString(data.name, 1, 160) &&
        data.trigger in [
          'inbound_intent', 'appointment_event', 'lims_report_ready',
          'discharge_event', 'scheduled_time', 'campaign_response', 'agent_action'
        ] &&
        data.consentPurpose in ['appointment_service', 'laboratory_service'] &&
        data.riskLevel in ['low', 'medium', 'high'] &&
        data.steps is list && data.steps.size() >= 1 && data.steps.size() <= 32 &&
        validSha256(data.contentHash) &&
        validSha256(data.secretBindingHash) &&
        validStrictId(data.ownerUid) &&
        data.lifecycleState in ['draft', 'review_pending', 'approved', 'retired'] &&
        (
          (
            data.lifecycleState in ['draft', 'review_pending'] &&
            data.approverUid == null && data.approvalHash == null &&
            data.approvalScope == null && data.approvedAt == null
          ) ||
          (
            data.lifecycleState in ['approved', 'retired'] &&
            validStrictId(data.approverUid) &&
            data.approverUid != data.ownerUid &&
            validSha256(data.approvalHash) &&
            data.approvalScope == 'simulation_only' &&
            data.approvedAt is timestamp
          )
        ) &&
        data.schemaVersion == 1 && data.synthetic == true &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validAutomationActivation(data, workspaceId, activationId) {
      return data.keys().size() == 20 &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'family', 'activeDefinitionId',
          'activeDefinitionVersion', 'activeDefinitionContentHash',
          'activeDefinitionApprovalHash', 'activeDefinitionApprovalScope',
          'activeDefinitionSecretBindingHash', 'activatedByUid', 'activatedAt',
          'activationEventId', 'activationAuditEventId', 'revision', 'createdAt',
          'updatedAt', 'schemaVersion', 'synthetic', 'externalDispatchCount',
          'networkCallCount'
        ]) &&
        validPhase5Identity(data, workspaceId, activationId) &&
        activationId in ['appointment_service', 'laboratory_service'] &&
        data.family == activationId &&
        validStrictId(data.activeDefinitionId) &&
        data.activeDefinitionVersion is int &&
        data.activeDefinitionVersion >= 1 && data.activeDefinitionVersion <= 1000000 &&
        validSha256(data.activeDefinitionContentHash) &&
        validSha256(data.activeDefinitionApprovalHash) &&
        data.activeDefinitionApprovalScope == 'simulation_only' &&
        validSha256(data.activeDefinitionSecretBindingHash) &&
        validStrictId(data.activatedByUid) &&
        data.activatedAt is timestamp &&
        validStrictId(data.activationEventId) &&
        validStrictId(data.activationAuditEventId) &&
        validPhase5Revision(data.revision) &&
        data.createdAt is timestamp && data.updatedAt is timestamp &&
        validPhase5SafeProjection(data);
    }

    function validAutomationDefinitionEvent(data, workspaceId, eventId) {
      return data.keys().size() == 21 &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'family', 'eventType', 'definitionId',
          'definitionVersion', 'definitionContentHash', 'definitionApprovalHash',
          'definitionApprovalScope', 'definitionSecretBindingHash',
          'fromLifecycleState', 'toLifecycleState', 'revision', 'auditEventId',
          'occurredAt', 'schemaVersion', 'synthetic', 'externalDispatchCount',
          'networkCallCount', 'actorKind', 'actorUid'
        ]) &&
        validPhase5Identity(data, workspaceId, eventId) &&
        data.family in ['appointment_service', 'laboratory_service'] &&
        data.eventType in ['created', 'review_requested', 'approved', 'activated', 'retired'] &&
        validStrictId(data.definitionId) &&
        data.definitionVersion is int &&
        data.definitionVersion >= 1 && data.definitionVersion <= 1000000 &&
        validSha256(data.definitionContentHash) &&
        (data.definitionApprovalHash == null || validSha256(data.definitionApprovalHash)) &&
        (data.definitionApprovalScope == null || data.definitionApprovalScope == 'simulation_only') &&
        validSha256(data.definitionSecretBindingHash) &&
        (data.fromLifecycleState == null || data.fromLifecycleState in ['draft', 'review_pending', 'approved', 'retired']) &&
        data.toLifecycleState in ['draft', 'review_pending', 'approved', 'retired'] &&
        validPhase5Revision(data.revision) &&
        validStrictId(data.auditEventId) && data.occurredAt is timestamp &&
        data.actorKind == 'staff' && validStrictId(data.actorUid) &&
        validPhase5SafeProjection(data);
    }

    function validAutomationRun(data, workspaceId, runId) {
      return data.keys().size() == 23 &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'definitionId', 'definitionVersion',
          'definitionContentHash', 'teamId', 'locationId', 'state',
          'pausedFromState', 'nextEligibleAt', 'openWorkItemId',
          'currentStepIndex', 'completedStepCount', 'attemptCount', 'revision',
          'outcomeCode', 'lastEventId', 'schemaVersion', 'synthetic',
          'externalDispatchCount', 'networkCallCount', 'createdAt', 'updatedAt'
        ]) &&
        validPhase5Identity(data, workspaceId, runId) &&
        validStrictId(data.definitionId) &&
