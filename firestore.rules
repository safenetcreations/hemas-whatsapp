    function validStaffSafeDemoIntegration(data, workspaceId, integrationId) {
      return data is map &&
        data.keys().size() == 17 &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'kind', 'displayName', 'environment',
          'adapterMode', 'status', 'credentialState', 'externalNetworkEnabled',
          'authoritativeSystemWriteEnabled', 'lastSyncAt', 'evidence', 'sortKey',
          'synthetic', 'schemaVersion', 'createdAt', 'updatedAt'
        ]) &&
        workspaceId == 'workspace_safenet_demo' &&
        data.id == integrationId &&
        data.workspaceId == workspaceId &&
        data.environment == 'demo' &&
        data.adapterMode == 'synthetic' &&
        data.status == 'mock' &&
        data.credentialState == 'not_configured' &&
        data.externalNetworkEnabled == false &&
        data.authoritativeSystemWriteEnabled == false &&
        data.lastSyncAt == null &&
        data.synthetic == true &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.createdAt <= data.updatedAt &&
        (
          (
            integrationId == 'integration_demo_his_simulator' &&
            data.kind == 'appointment_his' &&
            data.displayName == 'Local appointment HIS simulator' &&
            data.sortKey == '01_his_simulator' &&
            validDemoConnectionEvidence(
              data.evidence,
              'mock',
              'synthetic_fixture',
              'deterministic_his_simulator_only',
              data.createdAt,
              data.updatedAt
            )
          ) ||
          (
            integrationId == 'integration_demo_lims_simulator' &&
            data.kind == 'laboratory_lims' &&
            data.displayName == 'Local laboratory LIMS simulator' &&
            data.sortKey == '02_lims_simulator' &&
            validDemoConnectionEvidence(
              data.evidence,
              'mock',
              'synthetic_fixture',
              'deterministic_lims_simulator_only',
              data.createdAt,
              data.updatedAt
            )
          )
        );
    }

    function canReadDemoConnectionCentre(workspaceId) {
      return workspaceId == 'workspace_safenet_demo' &&
        hasRole(workspaceId, ['tenant_admin']);
    }

    // ===============================================================
    // AI/knowledge fixed-path retrospective governance projections
    // ===============================================================
    function aiGovernanceEvaluatedAt() {
      return timestamp.value(1786105800000);
    }

    function validAiGovernanceReadAuthority(workspaceId) {
      let member = memberData(workspaceId);
      let workspace = get(
        /databases/$(database)/documents/workspaces/$(workspaceId)
      ).data;
      return workspaceId == 'workspace_safenet_demo' &&
        workspaceAllowsSyntheticClientMutations(workspaceId) &&
        workspace.mode == 'demo' &&
        workspace.dataClassification == 'synthetic_only' &&
        activeWorkspaceMember(workspaceId) &&
        member.mfaSatisfied == true &&
        member.lastAuthenticatedAt is timestamp &&
        (
          (member.role == 'tenant_admin' && member.scopeMode == 'workspace_wide') ||
          (member.role == 'privacy_reviewer' && member.scopeMode == 'assigned') ||
          (
            member.role == 'supervisor' &&
            member.scopeMode == 'assigned' &&
            'team_demo_general' in member.teamIds &&
            'location_demo_wattala' in member.locationIds
          ) ||
          (
            member.role == 'clinical_approver' &&
            member.scopeMode == 'assigned' &&
            'team_demo_clinical_escalation' in member.teamIds &&
            'location_demo_wattala' in member.locationIds
          )
        );
    }

    function canGetAiKnowledgeDocument(workspaceId, documentId) {
      let member = memberData(workspaceId);
      return validAiGovernanceReadAuthority(workspaceId) &&
        documentId in [
          'kn-appointments-v3',
          'kn-labs-v2',
          'kn-urgent-v5',
          'kn-package-draft',
          'kn-old-hours'
        ] &&
        (
          member.role in ['tenant_admin', 'privacy_reviewer'] ||
          (
            member.role == 'supervisor' &&
            documentId in [
              'kn-appointments-v3',
              'kn-package-draft',
              'kn-old-hours'
            ]
          ) ||
          (
            member.role == 'clinical_approver' &&
            documentId in ['kn-labs-v2', 'kn-urgent-v5']
          )
        );
    }

    function canGetAiKnowledgeSelection(workspaceId, selectionId) {
      let member = memberData(workspaceId);
      return validAiGovernanceReadAuthority(workspaceId) &&
        selectionId in [
          'knowledge_selection_appointments_v3',
          'knowledge_selection_labs_v2',
          'knowledge_selection_urgent_v5'
        ] &&
        (
          member.role in ['tenant_admin', 'privacy_reviewer'] ||
          (
            member.role == 'supervisor' &&
            selectionId == 'knowledge_selection_appointments_v3'
          ) ||
          (
            member.role == 'clinical_approver' &&
            selectionId in [
              'knowledge_selection_labs_v2',
              'knowledge_selection_urgent_v5'
            ]
          )
        );
    }

    function canGetAiRuntimeEvidence(workspaceId, runtimeId) {
      let member = memberData(workspaceId);
      return validAiGovernanceReadAuthority(workspaceId) &&
        runtimeId in [
          'ai_run_demo_appointment_v1',
          'ai_run_demo_urgent_v1',
          'ai_run_demo_mixed_v1',
          'ai_run_demo_stop_v1',
          'ai_run_event_demo_appointment_v1',
          'ai_run_event_demo_urgent_v1',
          'ai_run_event_demo_mixed_v1',
          'ai_run_event_demo_stop_v1'
        ] &&
        (
          member.role == 'tenant_admin' ||
          (
            member.role == 'supervisor' &&
            runtimeId in [
              'ai_run_demo_appointment_v1',
              'ai_run_demo_mixed_v1',
              'ai_run_demo_stop_v1',
              'ai_run_event_demo_appointment_v1',
              'ai_run_event_demo_mixed_v1',
              'ai_run_event_demo_stop_v1'
            ]
          ) ||
          (
            member.role == 'clinical_approver' &&
            runtimeId in [
              'ai_run_demo_urgent_v1',
              'ai_run_event_demo_urgent_v1'
            ]
          )
        );
    }

    function validAiKnowledgeDocumentMatrix(data, documentId) {
      return (
          documentId == 'kn-appointments-v3' &&
          data.title == 'Appointment service guide' &&
          data.version == '3.1' &&
          data.language == 'trilingual' &&
          data.contentKind == 'appointment_service_guide' &&
          data.ownerUid == 'user_demo_supervisor' &&
          data.approverUid == 'user_demo_admin' &&
          data.approvalState == 'approved' &&
          data.approvalScope == 'synthetic_information_only' &&
          data.approvedAt == timestamp.value(1785542400000) &&
          data.effectiveFrom == timestamp.value(1785542400000) &&
          data.effectiveUntil == timestamp.value(1793491199999)
        ) || (
          documentId == 'kn-labs-v2' &&
          data.title == 'Laboratory notification policy' &&
          data.version == '2.4' &&
          data.language == 'trilingual' &&
          data.contentKind == 'laboratory_notification_policy' &&
          data.ownerUid == 'user_demo_clinical_approver' &&
          data.approverUid == 'user_demo_admin' &&
          data.approvalState == 'approved' &&
          data.approvalScope == 'synthetic_information_only' &&
          data.approvedAt == timestamp.value(1782864000000) &&
          data.effectiveFrom == timestamp.value(1782864000000) &&
          data.effectiveUntil == timestamp.value(1790812799999)
        ) || (
          documentId == 'kn-urgent-v5' &&
          data.title == 'Urgent-language response' &&
          data.version == '5.0' &&
          data.language == 'trilingual' &&
          data.contentKind == 'urgent_language_response' &&
          data.ownerUid == 'user_demo_clinical_approver' &&
          data.approverUid == 'user_demo_admin' &&
          data.approvalState == 'approved' &&
          data.approvalScope == 'synthetic_information_only' &&
          data.approvedAt == timestamp.value(1785542400000) &&
          data.effectiveFrom == timestamp.value(1785542400000) &&
          data.effectiveUntil == timestamp.value(1788220799999)
        ) || (
          documentId == 'kn-package-draft' &&
          data.title == 'Package information draft' &&
          data.version == '0.8' &&
          data.language == 'en' &&
          data.contentKind == 'package_information_draft' &&
          data.ownerUid == 'user_demo_supervisor' &&
          data.approverUid == null &&
          data.approvalState == 'review' &&
          data.approvalScope == null &&
          data.approvedAt == null &&
          data.effectiveFrom == null &&
          data.effectiveUntil == null
        ) || (
          documentId == 'kn-old-hours' &&
          data.title == 'Archived branch-hours sample' &&
          data.version == '1.2' &&
          data.language == 'en' &&
          data.contentKind == 'archived_branch_hours' &&
          data.ownerUid == 'user_demo_supervisor' &&
          data.approverUid == 'user_demo_admin' &&
          data.approvalState == 'expired' &&
          data.approvalScope == 'synthetic_information_only' &&
          data.approvedAt == timestamp.value(1780272000000) &&
          data.effectiveFrom == timestamp.value(1780272000000) &&
          data.effectiveUntil == timestamp.value(1785542399999)
        );
    }

    function validStaffSafeAiKnowledgeDocument(data, workspaceId, documentId) {
      return data is map &&
        data == {
          'id': documentId,
          'workspaceId': workspaceId,
          'title': data.title,
          'version': data.version,
          'language': data.language,
          'contentKind': data.contentKind,
          'ownerUid': data.ownerUid,
          'approverUid': data.approverUid,
          'approvalState': data.approvalState,
          'approvalScope': data.approvalScope,
          'approvedAt': data.approvedAt,
          'evaluatedAt': aiGovernanceEvaluatedAt(),
          'effectiveFrom': data.effectiveFrom,
          'effectiveUntil': data.effectiveUntil,
          'contentFingerprint': data.contentFingerprint,
          'approvalFingerprint': data.approvalFingerprint,
          'synthetic': true,
          'schemaVersion': 1,
          'createdAt': data.createdAt,
          'updatedAt': data.updatedAt
        } &&
        validSha256(data.contentFingerprint) &&
        validSha256(data.approvalFingerprint) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.createdAt <= data.updatedAt &&
        validAiKnowledgeDocumentMatrix(data, documentId);
    }

    function validAiKnowledgeSelectionMatrix(data, selectionId) {
      return (
          selectionId == 'knowledge_selection_appointments_v3' &&
          data.documentId == 'kn-appointments-v3' &&
          data.effectiveFrom == timestamp.value(1785542400000) &&
          data.effectiveUntil == timestamp.value(1793491199999)
        ) || (
          selectionId == 'knowledge_selection_labs_v2' &&
          data.documentId == 'kn-labs-v2' &&
          data.effectiveFrom == timestamp.value(1782864000000) &&
          data.effectiveUntil == timestamp.value(1790812799999)
        ) || (
          selectionId == 'knowledge_selection_urgent_v5' &&
          data.documentId == 'kn-urgent-v5' &&
          data.effectiveFrom == timestamp.value(1785542400000) &&
          data.effectiveUntil == timestamp.value(1788220799999)
        );
    }

    function validStaffSafeAiKnowledgeSelection(data, workspaceId, selectionId) {
      return data is map &&
        data == {
          'selectionId': selectionId,
          'workspaceId': workspaceId,
          'documentId': data.documentId,
          'contentFingerprint': data.contentFingerprint,
          'approvalFingerprint': data.approvalFingerprint,
          'selectorVersionId': 'deterministic_knowledge_selector_v1',
          'selectedAt': aiGovernanceEvaluatedAt(),
          'evaluatedAt': aiGovernanceEvaluatedAt(),
          'selectionScope': 'retrospective_synthetic_fixture',
          'effectiveFrom': data.effectiveFrom,
          'effectiveUntil': data.effectiveUntil,
          'synthetic': true,
          'selectionFingerprint': data.selectionFingerprint,
          'schemaVersion': 1,
          'createdAt': data.createdAt
        } &&
        validSha256(data.contentFingerprint) &&
        validSha256(data.approvalFingerprint) &&
        validSha256(data.selectionFingerprint) &&
        data.createdAt is timestamp &&
        data.createdAt > aiGovernanceEvaluatedAt() &&
        validAiKnowledgeSelectionMatrix(data, selectionId);
    }

    function validAiRetrospectiveSelection(data, scenarioId) {
      return (
          scenarioId == 'appointment' &&
          data.knowledgeSelectionId == 'knowledge_selection_appointments_v3' &&
          validSha256(data.knowledgeSelectionFingerprint)
        ) || (
          scenarioId == 'urgent' &&
          data.knowledgeSelectionId == 'knowledge_selection_urgent_v5' &&
          validSha256(data.knowledgeSelectionFingerprint)
        ) || (
          scenarioId in ['mixed', 'stop'] &&
          data.knowledgeSelectionId == null &&
          data.knowledgeSelectionFingerprint == null
        );
    }

    function validAiRetrospectiveDecision(data, scenarioId) {
      return data.unsupportedClaim == false &&
        data.privacy == 'pass' &&
        data.serviceWindow == 'in_window' &&
        data.retryCount == 0 &&
        data.eventCount == 1 &&
        data.modelCallCount == 0 &&
        data.providerCallCount == 0 &&
        data.externalDispatchCount == 0 &&
        data.conversationMutationCount == 0 &&
        data.handoffMutationCount == 0 &&
        data.suppressionMutationCount == 0 &&
        data.chainOfThoughtStored == false &&
        (
          (
            scenarioId == 'appointment' &&
            data.decision == 'pass' &&
            data.reasonCodes == ['approved_knowledge_only'] &&
            data.clinicalSafety == 'pass' &&
            data.requiredCorrectionCode == null &&
            data.marketingSuppressionRequired == false &&
            data.sendMode == 'preview_only' &&
            data.outcome == 'preview_only' &&
            data.observedConversationStatus == 'active' &&
            data.observedConversationMode == 'automation' &&
            data.handoffRequired == false &&
            data.urgentSafetyHoldObserved == false &&
            data.contactMarketingSuppressionObserved == false &&
            data.ordinaryAutomationPaused == false
          ) || (
            scenarioId == 'urgent' &&
            data.decision == 'fail' &&
            data.reasonCodes == ['urgent_language'] &&
            data.clinicalSafety == 'blocked' &&
            data.requiredCorrectionCode == 'preserve_existing_safety_hold' &&
            data.marketingSuppressionRequired == false &&
            data.sendMode == 'no_send' &&
            data.outcome == 'safety_hold_already_present' &&
            data.observedConversationStatus == 'escalated' &&
            data.observedConversationMode == 'safety_hold' &&
            data.handoffRequired == true &&
            data.urgentSafetyHoldObserved == true &&
            data.contactMarketingSuppressionObserved == false &&
            data.ordinaryAutomationPaused == true
          ) || (
            scenarioId == 'mixed' &&
            data.decision == 'fail' &&
            data.reasonCodes == ['low_language_confidence'] &&
            data.clinicalSafety == 'pass' &&
            data.requiredCorrectionCode == 'preserve_existing_human_takeover' &&
            data.marketingSuppressionRequired == false &&
            data.sendMode == 'no_send' &&
            data.outcome == 'human_takeover_already_present' &&
            data.observedConversationStatus == 'assigned' &&
            data.observedConversationMode == 'human_takeover' &&
            data.handoffRequired == true &&
            data.urgentSafetyHoldObserved == false &&
            data.contactMarketingSuppressionObserved == false &&
            data.ordinaryAutomationPaused == true
          ) || (
            scenarioId == 'stop' &&
            data.decision == 'fail' &&
            data.reasonCodes == ['stop_intent'] &&
            data.clinicalSafety == 'pass' &&
            data.requiredCorrectionCode == 'honor_existing_marketing_suppression' &&
            data.marketingSuppressionRequired == true &&
            data.sendMode == 'no_send' &&
            data.outcome == 'suppression_already_recorded' &&
            data.observedConversationStatus == 'resolved' &&
            data.observedConversationMode == 'automation' &&
            data.handoffRequired == false &&
            data.urgentSafetyHoldObserved == false &&
            data.contactMarketingSuppressionObserved == true &&
            data.ordinaryAutomationPaused == true
          )
        );
    }

    function validAiRunIdentity(data, scenarioId, runId) {
      return (
          scenarioId == 'appointment' &&
          runId == 'ai_run_demo_appointment_v1' &&
          data.eventId == 'ai_run_event_demo_appointment_v1' &&
          data.auditEventId == 'audit_ai_run_demo_appointment_v1'
        ) || (
          scenarioId == 'urgent' &&
          runId == 'ai_run_demo_urgent_v1' &&
          data.eventId == 'ai_run_event_demo_urgent_v1' &&
          data.auditEventId == 'audit_ai_run_demo_urgent_v1'
        ) || (
          scenarioId == 'mixed' &&
          runId == 'ai_run_demo_mixed_v1' &&
          data.eventId == 'ai_run_event_demo_mixed_v1' &&
          data.auditEventId == 'audit_ai_run_demo_mixed_v1'
        ) || (
          scenarioId == 'stop' &&
          runId == 'ai_run_demo_stop_v1' &&
          data.eventId == 'ai_run_event_demo_stop_v1' &&
          data.auditEventId == 'audit_ai_run_demo_stop_v1'
        );
    }

    function validStaffSafeAiRetrospectiveRun(data, workspaceId, runId) {
      return data is map &&
        data.keys().size() == 44 &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'scenarioId', 'evaluationScope',
          'durableScenarioScope', 'requestFingerprint', 'knowledgeSelectionId',
          'knowledgeSelectionFingerprint', 'modelProvider', 'modelId',
          'promptVersionId', 'policyVersionId', 'reviewerVersionId', 'eventId',
          'auditEventId', 'evaluatedAt', 'recordedAt', 'decision', 'reasonCodes',
          'unsupportedClaim', 'clinicalSafety', 'privacy', 'serviceWindow',
          'requiredCorrectionCode', 'marketingSuppressionRequired', 'sendMode',
          'outcome', 'observedConversationStatus', 'observedConversationMode',
          'handoffRequired', 'urgentSafetyHoldObserved',
          'contactMarketingSuppressionObserved', 'ordinaryAutomationPaused',
          'retryCount', 'eventCount', 'modelCallCount', 'providerCallCount',
          'externalDispatchCount', 'conversationMutationCount',
          'handoffMutationCount', 'suppressionMutationCount',
          'chainOfThoughtStored', 'synthetic', 'schemaVersion'
        ]) &&
        data.id == runId &&
        data.workspaceId == workspaceId &&
        data.scenarioId in ['appointment', 'urgent', 'mixed', 'stop'] &&
        data.evaluationScope == 'retrospective_synthetic_fixture' &&
        data.durableScenarioScope == 'partial_four_of_seven' &&
        validSha256(data.requestFingerprint) &&
        validAiRetrospectiveSelection(data, data.scenarioId) &&
        data.modelProvider == 'none' &&
        data.modelId == null &&
        data.promptVersionId == null &&
        data.policyVersionId == 'ai_policy_synthetic_v1' &&
        data.reviewerVersionId == 'deterministic_healthcare_reviewer_v1' &&
        data.evaluatedAt == aiGovernanceEvaluatedAt() &&
        data.recordedAt is timestamp &&
        data.recordedAt > data.evaluatedAt &&
        data.synthetic == true &&
        data.schemaVersion == 1 &&
        validAiRunIdentity(data, data.scenarioId, runId) &&
        validAiRetrospectiveDecision(data, data.scenarioId);
    }

    function validAiEventIdentity(data, scenarioId, eventId) {
      return (
          scenarioId == 'appointment' &&
          eventId == 'ai_run_event_demo_appointment_v1' &&
          data.runId == 'ai_run_demo_appointment_v1' &&
          data.auditEventId == 'audit_ai_run_demo_appointment_v1'
        ) || (
          scenarioId == 'urgent' &&
          eventId == 'ai_run_event_demo_urgent_v1' &&
          data.runId == 'ai_run_demo_urgent_v1' &&
          data.auditEventId == 'audit_ai_run_demo_urgent_v1'
        ) || (
          scenarioId == 'mixed' &&
          eventId == 'ai_run_event_demo_mixed_v1' &&
          data.runId == 'ai_run_demo_mixed_v1' &&
          data.auditEventId == 'audit_ai_run_demo_mixed_v1'
        ) || (
          scenarioId == 'stop' &&
          eventId == 'ai_run_event_demo_stop_v1' &&
          data.runId == 'ai_run_demo_stop_v1' &&
          data.auditEventId == 'audit_ai_run_demo_stop_v1'
        );
    }

    function validStaffSafeAiRetrospectiveEvent(data, workspaceId, eventId) {
      return data is map &&
        data.keys().size() == 47 &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'runId', 'scenarioId', 'eventType', 'sequence',
          'previousEventId', 'retryOfEventId', 'requestFingerprint',
          'runFingerprint', 'knowledgeSelectionId', 'knowledgeSelectionFingerprint',
          'modelProvider', 'modelId', 'promptVersionId', 'policyVersionId',
          'reviewerVersionId', 'auditEventId', 'evaluatedAt', 'createdAt',
          'decision', 'reasonCodes', 'unsupportedClaim', 'clinicalSafety',
          'privacy', 'serviceWindow', 'requiredCorrectionCode',
          'marketingSuppressionRequired', 'sendMode', 'outcome',
          'observedConversationStatus', 'observedConversationMode',
          'handoffRequired', 'urgentSafetyHoldObserved',
          'contactMarketingSuppressionObserved', 'ordinaryAutomationPaused',
          'retryCount', 'eventCount', 'modelCallCount', 'providerCallCount',
          'externalDispatchCount', 'conversationMutationCount',
          'handoffMutationCount', 'suppressionMutationCount',
          'chainOfThoughtStored', 'synthetic', 'schemaVersion'
        ]) &&
        data.id == eventId &&
        data.workspaceId == workspaceId &&
        data.scenarioId in ['appointment', 'urgent', 'mixed', 'stop'] &&
        data.eventType == 'retrospective_evaluation_recorded' &&
        data.sequence == 1 &&
        data.previousEventId == null &&
        data.retryOfEventId == null &&
        validSha256(data.requestFingerprint) &&
        validSha256(data.runFingerprint) &&
        validAiRetrospectiveSelection(data, data.scenarioId) &&
        data.modelProvider == 'none' &&
        data.modelId == null &&
        data.promptVersionId == null &&
        data.policyVersionId == 'ai_policy_synthetic_v1' &&
        data.reviewerVersionId == 'deterministic_healthcare_reviewer_v1' &&
        data.evaluatedAt == aiGovernanceEvaluatedAt() &&
        data.createdAt is timestamp &&
        data.createdAt > data.evaluatedAt &&
        data.synthetic == true &&
        data.schemaVersion == 1 &&
        validAiEventIdentity(data, data.scenarioId, eventId) &&
        validAiRetrospectiveDecision(data, data.scenarioId);
    }

    function validFirestoreAuditRecordV1(data, workspaceId, auditEventId) {
      return data.keys().size() == 14 &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'actorUid', 'actorType', 'action', 'resourceType',
          'resourceId', 'outcome', 'requestId', 'occurredAt', 'createdAt',
          'metadata', 'synthetic', 'schemaVersion'
        ]) &&
        validPhase5Identity(data, workspaceId, auditEventId) &&
        validStrictId(data.actorUid) && data.actorType in ['user', 'service', 'system'] &&
        validBoundedString(data.action, 3, 160) &&
        data.action.matches('^[a-z][a-z0-9_-]*([.][a-z][a-z0-9_-]*)+$') &&
        validBoundedString(data.resourceType, 1, 80) && validStrictId(data.resourceId) &&
        data.outcome in ['allowed', 'denied', 'failed', 'simulated'] &&
        validStrictId(data.requestId) && data.occurredAt is timestamp &&
        data.createdAt is timestamp && data.createdAt == data.occurredAt &&
        data.metadata is map && data.metadata.keys().size() <= 32 &&
        data.synthetic == true && data.schemaVersion == 1;
    }

    function canGetPhase5CatalogueAudit(workspaceId, data) {
      return (
          (
            canReadAutomationCatalogue(workspaceId) &&
            data.resourceType == 'automation_definition' &&
            data.action in [
              'automation_definition.create',
              'automation_definition.request_review',
              'automation_definition.approve',
              'automation_definition.activate',
              'automation_definition.retire'
            ]
          ) ||
          (
            canReadCareCatalogue(workspaceId) &&
            data.resourceType == 'care_pathway' &&
            data.action in [
              'care_pathway.create',
              'care_pathway.request_clinical_review',
              'care_pathway.approve',
              'care_pathway.activate',
              'care_pathway.retire'
            ]
          )
        );
    }

    function canGetPrivilegedOrOwnAudit(workspaceId, data) {
      return hasRole(workspaceId, ['tenant_admin', 'privacy_reviewer']) ||
        (
          activeWorkspaceMember(workspaceId) &&
          data.actorUid == request.auth.uid
        );
    }

    function canGetAuditEvent(workspaceId, data, auditEventId) {
      return validFirestoreAuditRecordV1(data, workspaceId, auditEventId) &&
        (
          canGetPrivilegedOrOwnAudit(workspaceId, data) ||
          canGetPhase5CatalogueAudit(workspaceId, data)
        );
    }

    // ===============================================================
    // Workspace authority and non-patient reference data
    // ===============================================================
    match /workspaces/{workspaceId} {
      allow read: if activeWorkspaceMember(workspaceId) &&
        resource.data.id == workspaceId;

      // Workspace lifecycle/configuration is server-managed and audited.
      allow create, update, delete: if false;

      match /members/{memberId} {
        allow read: if activeWorkspaceMember(workspaceId) &&
          isSameWorkspace(resource.data, workspaceId) &&
          resource.data.id == memberId &&
          resource.data.uid == memberId &&
          (
            request.auth.uid == memberId ||
            hasRole(workspaceId, ['tenant_admin'])
          );

        // Authority source is server-managed. No member, including a tenant
        // admin, can self-create, edit, revoke or promote membership directly.
        allow create, update, delete: if false;
      }

      match /teams/{teamId} {
        allow get: if activeWorkspaceMember(workspaceId) &&
          isSameWorkspace(resource.data, workspaceId) &&
          resource.data.id == teamId;
        allow list: if activeWorkspaceMember(workspaceId) && isBoundedList();
        allow create, update, delete: if false;
      }

      match /locations/{locationId} {
        allow get: if activeWorkspaceMember(workspaceId) &&
          isSameWorkspace(resource.data, workspaceId) &&
          resource.data.id == locationId;
        allow list: if activeWorkspaceMember(workspaceId) && isBoundedList();
        allow create, update, delete: if false;
      }

      // --- Live canary read models (content-free by construction) ---------
      // Daily usage counters, campaign summaries and per-recipient delivery
      // states carry counters/status only — no bodies, no identifiers beyond
      // masked last4. Written exclusively by trusted backend writers; any
      // active workspace member may read them (Analytics / Campaigns pages).

      match /canary_metrics/{metricId} {
        allow get: if activeWorkspaceMember(workspaceId) &&
          isSameWorkspace(resource.data, workspaceId) &&
          resource.data.id == metricId &&
          resource.data.containsMessageContent == false;
        allow list: if activeWorkspaceMember(workspaceId) && isBoundedList();
        allow create, update, delete: if false;
      }

      match /canary_campaigns/{campaignId} {
        allow get: if activeWorkspaceMember(workspaceId) &&
          isSameWorkspace(resource.data, workspaceId) &&
          resource.data.id == campaignId &&
          resource.data.containsMessageContent == false;
        allow list: if activeWorkspaceMember(workspaceId) && isBoundedList();
        allow create, update, delete: if false;
      }

      match /canary_campaign_sends/{sendId} {
        allow get: if activeWorkspaceMember(workspaceId) &&
          isSameWorkspace(resource.data, workspaceId) &&
          resource.data.id == sendId &&
          resource.data.containsMessageContent == false;
        allow list: if activeWorkspaceMember(workspaceId) && isBoundedList();
        allow create, update, delete: if false;
      }

      match /whatsappConnections/{connectionId} {
        allow get: if canReadDemoConnectionCentre(workspaceId) &&
          connectionId == 'connection_demo_simulator' &&
          (
            !exists(
              /databases/$(database)/documents/workspaces/$(workspaceId)/whatsappConnections/$(connectionId)
            ) ||
            validStaffSafeDemoWhatsAppConnection(
              resource.data,
              workspaceId,
              connectionId
            )
          );
        // The frozen one-document catalogue is fetched only by exact path.
        // Firestore cannot prove all strict document literals for list reads.
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /whatsappConnectionSecrets/{document=**} {
        // Raw Meta asset identifiers and Secret Manager references never have
        // a direct browser read or write path. The demo seeds zero records.
        allow get, list, create, update, delete: if false;
      }

      // =============================================================
      // Patient-operational and clinical-adjacent data
      // =============================================================
      match /contactSecrets/{contactId} {
        // Protected contact lookup and reference material is backend-only.
        // Admin SDK callers bypass Rules and must validate the exact schema,
        // tenant path and audited purpose before reading or writing it.
        allow read, write: if false;
      }

      match /labReportSecrets/{labReportId} {
        // External report references, notification fingerprints and protected
        // handoff references are available only to purpose-bound server code.
        allow get, list, create, update, delete: if false;
      }

      match /labReportEventSecrets/{eventId} {
        // Immutable-event replay fingerprints are never client-readable.
        allow get, list, create, update, delete: if false;
      }

      match /contacts/{contactId} {
        allow get: if canReadScopedPatientData(workspaceId, resource.data) &&
          resource.data.id == contactId &&
          isValidStaffContactReadModel(resource.data, workspaceId);
        // Firestore queries cannot prove a full-document schema allowlist.
        // The exact staff schema is therefore enforced by every trusted
        // backend writer plus the strict client parser; list authorization
        // remains tenant/scope/limit constrained here.
        allow list: if canListScopedPatientData(workspaceId, resource.data);
        allow update: if workspaceAllowsSyntheticClientMutations(workspaceId) &&
          hasRole(workspaceId, ['tenant_admin']) &&
          isSameWorkspace(resource.data, workspaceId) &&
          hasValidPatientScope(resource.data) &&
          isValidSyntheticContactPreferenceState(
            request.resource.data,
            workspaceId,
            contactId
          ) &&
          validContactPreferenceTransition();
        allow create, delete: if false;
      }

      match /consentRecords/{consentRecordId} {
        allow get: if canReadConsentData(workspaceId, resource.data) &&
          resource.data.id == consentRecordId;
        allow list: if canListConsentData(workspaceId, resource.data);

        // Consent is evidence. Only backend services may append records after
        // source/provenance verification. Existing records never mutate.
        allow create, update, delete: if false;
      }

      match /conversations/{conversationId} {
        allow get: if canReadScopedPatientData(workspaceId, resource.data) &&
          resource.data.id == conversationId;
        allow list: if canListScopedPatientData(workspaceId, resource.data);
        allow create, update, delete: if false;
      }

      match /messages/{messageId} {
        allow get: if canReadScopedPatientData(workspaceId, resource.data) &&
          resource.data.id == messageId;
        allow list: if canListScopedPatientData(workspaceId, resource.data);
        allow create, update, delete: if false;
      }

      match /handoffSessions/{handoffId} {
        // The corrected retrospective milestone observes an existing
        // conversation mode only; it never creates or exposes a handoff
        // aggregate through the browser.
        allow get, list, create, update, delete: if false;
      }

      match /internalNotes/{noteId} {
        allow get: if workspaceAllowsSyntheticClientMutations(workspaceId) &&
          canReadScopedPatientData(workspaceId, resource.data) &&
          resource.data.synthetic == true &&
          resource.data.id == noteId;
        allow list: if workspaceAllowsSyntheticClientMutations(workspaceId) &&
          canListScopedPatientData(workspaceId, resource.data) &&
          resource.data.synthetic == true;

        // Notes are server-authored through the purpose-bound audited callable.
        // The browser cannot fabricate, overwrite or delete staff evidence.
        allow create, update, delete: if false;
      }

      match /aiRuns/{aiRunId} {
        allow get: if aiRunId in [
            'ai_run_demo_appointment_v1',
            'ai_run_demo_urgent_v1',
            'ai_run_demo_mixed_v1',
            'ai_run_demo_stop_v1'
          ] &&
          canGetAiRuntimeEvidence(workspaceId, aiRunId) &&
          (
            !exists(
              /databases/$(database)/documents/workspaces/$(workspaceId)/aiRuns/$(aiRunId)
            ) ||
            validStaffSafeAiRetrospectiveRun(resource.data, workspaceId, aiRunId)
          );
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /aiRunEvents/{eventId} {
        allow get: if eventId in [
            'ai_run_event_demo_appointment_v1',
            'ai_run_event_demo_urgent_v1',
            'ai_run_event_demo_mixed_v1',
            'ai_run_event_demo_stop_v1'
          ] &&
          canGetAiRuntimeEvidence(workspaceId, eventId) &&
          (
            !exists(
              /databases/$(database)/documents/workspaces/$(workspaceId)/aiRunEvents/$(eventId)
            ) ||
            validStaffSafeAiRetrospectiveEvent(resource.data, workspaceId, eventId)
          );
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /aiRunSecrets/{document=**} {
        allow get, list, create, update, delete: if false;
      }

      match /aiRunEventSecrets/{document=**} {
        allow get, list, create, update, delete: if false;
      }

      match /appointments/{appointmentId} {
        allow get: if canReadScopedPatientData(workspaceId, resource.data) &&
          resource.data.id == appointmentId;
        allow list: if canListScopedPatientData(workspaceId, resource.data);
        allow create, update, delete: if false;
      }

      match /appointmentEvents/{eventId} {
        allow get: if canReadScopedPatientData(workspaceId, resource.data) &&
          resource.data.id == eventId;
        allow list: if canListScopedPatientData(workspaceId, resource.data);
        allow create, update, delete: if false;
      }

      match /labReports/{labReportId} {
        allow get: if canReadScopedPatientData(workspaceId, resource.data) &&
          isValidStaffSafeLabReport(resource.data, workspaceId, labReportId);
        // Firestore cannot prove a full-document schema allowlist from query
        // constraints. Trusted writers enforce the staff-safe schema and the
        // strict repository parser fails the complete list closed if polluted.
        allow list: if canListScopedPatientData(workspaceId, resource.data);
        allow create, update, delete: if false;
      }

      match /labReportEvents/{eventId} {
        allow get: if canReadScopedPatientData(workspaceId, resource.data) &&
          isValidStaffSafeLabReportEvent(resource.data, workspaceId, eventId);
        allow list: if canListScopedPatientData(workspaceId, resource.data);
        allow create, update, delete: if false;
      }

      // =============================================================
      // Knowledge, templates, campaigns and governed automation
      // =============================================================
      match /knowledgeDocuments/{knowledgeDocumentId} {
        allow get: if canGetAiKnowledgeDocument(workspaceId, knowledgeDocumentId) &&
          (
            !exists(
              /databases/$(database)/documents/workspaces/$(workspaceId)/knowledgeDocuments/$(knowledgeDocumentId)
            ) ||
            validStaffSafeAiKnowledgeDocument(
              resource.data,
              workspaceId,
              knowledgeDocumentId
            )
          );
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /knowledgeSelections/{selectionId} {
        allow get: if canGetAiKnowledgeSelection(workspaceId, selectionId) &&
          (
            !exists(
              /databases/$(database)/documents/workspaces/$(workspaceId)/knowledgeSelections/$(selectionId)
            ) ||
            validStaffSafeAiKnowledgeSelection(
              resource.data,
              workspaceId,
              selectionId
            )
          );
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /knowledgeDocumentSecrets/{document=**} {
        allow get, list, create, update, delete: if false;
      }

      match /templates/{templateId} {
        allow get: if canGetTemplateCatalogueItem(
            resource.data,
            workspaceId,
            templateId
          );
        allow list: if canReadTemplateCatalogue(workspaceId) && isBoundedList();

        // Local drafts and every released version are backend-governed. A
        // browser cannot claim provider submission/approval, edit immutable
        // components/variables/language/version or change SafeNet ownership.
        allow create, update, delete: if false;
      }

      match /flows/{flowId} {
        allow get: if canReadTemplateCatalogue(workspaceId) &&
          isSameWorkspace(resource.data, workspaceId) &&
          resource.data.id == flowId;
        allow list: if canReadTemplateCatalogue(workspaceId) && isBoundedList();

        // Flow/provider status and endpoint metadata are server-only.
        allow create, update, delete: if false;
      }

      match /flowSessions/{flowSessionId} {
        allow read: if canReadScopedPatientData(workspaceId, resource.data) &&
          resource.data.id == flowSessionId;
        allow create, update, delete: if false;
      }

      match /campaigns/{campaignId} {
        allow get: if canReadCampaignData(workspaceId, resource.data) &&
          isValidGovernedCampaign(resource.data, workspaceId, campaignId);
        // Queries cannot prove an arbitrary whole-document key allowlist.
        // Trusted writers enforce it and the repository parser rejects the
        // complete bounded list when any record is polluted.
        allow list: if canListCampaignData(workspaceId);
        allow create, update, delete: if false;
      }

      match /audienceSnapshots/{snapshotId} {
        allow get: if canReadCampaignData(workspaceId, resource.data) &&
          isValidAudienceSnapshot(resource.data, workspaceId, snapshotId);
        allow list: if canListCampaignData(workspaceId);
        allow create, update, delete: if false;
      }

      match /campaignEvents/{eventId} {
        allow get: if canReadCampaignData(workspaceId, resource.data) &&
          isValidCampaignEvent(resource.data, workspaceId, eventId);
        allow list: if canListCampaignData(workspaceId);
        allow create, update, delete: if false;
      }

      match /campaignCheckpoints/{checkpointId} {
        allow get: if canReadCampaignData(workspaceId, resource.data) &&
          isValidCampaignCheckpoint(resource.data, workspaceId, checkpointId);
        allow list: if canListCampaignData(workspaceId);
        allow create, update, delete: if false;
      }

      match /campaignRecipients/{recipientId} {
        // Recipient/patient state is backend-owned and not exposed by the
        // governed aggregate campaign read model.
        allow get, list, create, update, delete: if false;
      }

      match /automationDefinitions/{definitionId} {
        allow get: if canReadAutomationCatalogue(workspaceId) &&
          validAutomationDefinition(resource.data, workspaceId, definitionId);
        allow list: if canListAutomationCatalogue(workspaceId, resource.data);
        allow create, update, delete: if false;
      }

      match /automationActivations/{activationId} {
        allow get: if canReadAutomationCatalogue(workspaceId) &&
          validAutomationActivation(resource.data, workspaceId, activationId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /automationDefinitionEvents/{eventId} {
        allow get: if canReadAutomationCatalogue(workspaceId) &&
          validAutomationDefinitionEvent(resource.data, workspaceId, eventId);
        allow list: if canListAutomationCatalogue(workspaceId, resource.data);
        allow create, update, delete: if false;
      }

      match /automationRuns/{runId} {
        allow get: if canReadAutomationExecution(workspaceId, resource.data) &&
          validAutomationRun(resource.data, workspaceId, runId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /automationRunEvents/{eventId} {
        allow get: if canReadAutomationExecution(workspaceId, resource.data) &&
          validAutomationRunEvent(resource.data, workspaceId, eventId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /automationWorkItems/{workItemId} {
        allow get: if canReadAutomationExecution(workspaceId, resource.data) &&
          validAutomationWorkItem(resource.data, workspaceId, workItemId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /carePathways/{pathwayId} {
        allow get: if canReadCareCatalogue(workspaceId) &&
          validCarePathway(resource.data, workspaceId, pathwayId);
        allow list: if canListCareCatalogue(workspaceId, resource.data);
        allow create, update, delete: if false;
      }

      match /carePathwayActivations/{activationId} {
        allow get: if canReadCareCatalogue(workspaceId) &&
          validCarePathwayActivation(resource.data, workspaceId, activationId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /carePathwayEvents/{eventId} {
        allow get: if canReadCareCatalogue(workspaceId) &&
          validCarePathwayEvent(resource.data, workspaceId, eventId);
        allow list: if canListCareCatalogue(workspaceId, resource.data);
        allow create, update, delete: if false;
      }

      match /careEnrollments/{enrollmentId} {
        allow get: if canReadCareExecution(workspaceId, resource.data) &&
          validCareEnrollment(resource.data, workspaceId, enrollmentId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /careEnrollmentEvents/{eventId} {
        allow get: if canReadCareExecution(workspaceId, resource.data) &&
          validCareEnrollmentEvent(resource.data, workspaceId, eventId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /careEscalations/{escalationId} {
        allow get: if canReadCareExecution(workspaceId, resource.data) &&
          validCareEscalation(resource.data, workspaceId, escalationId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /careHandoffs/{handoffId} {
        allow get: if canReadCareExecution(workspaceId, resource.data) &&
          validCareHandoff(resource.data, workspaceId, handoffId);
        allow list: if false;
        allow create, update, delete: if false;
      }

      // All protected configuration, identity, replay and clinical-context
      // projections are Admin-SDK-only. The explicit matches make a future
      // broad workspace rule unable to expose one by accident.
      match /automationDefinitionSecrets/{document=**} {
        allow get, list, create, update, delete: if false;
      }
      match /automationTriggerReceipts/{document=**} {
        allow get, list, create, update, delete: if false;
      }
      match /automationRunSecrets/{document=**} {
        allow get, list, create, update, delete: if false;
      }
      match /automationRunEventSecrets/{document=**} {
        allow get, list, create, update, delete: if false;
      }
      match /automationWorkItemSecrets/{document=**} {
        allow get, list, create, update, delete: if false;
      }
      match /carePathwaySecrets/{document=**} {
        allow get, list, create, update, delete: if false;
      }
      match /careEnrollmentReceipts/{document=**} {
        allow get, list, create, update, delete: if false;
      }
      match /careEnrollmentSecrets/{document=**} {
        allow get, list, create, update, delete: if false;
      }
      match /careEnrollmentEventSecrets/{document=**} {
        allow get, list, create, update, delete: if false;
      }
      match /careEscalationSecrets/{document=**} {
        allow get, list, create, update, delete: if false;
      }
      // =============================================================
      // Connections, metering, aggregate analytics and audit
      // =============================================================
      match /integrations/{integrationId} {
        allow get: if canReadDemoConnectionCentre(workspaceId) &&
          integrationId in [
            'integration_demo_his_simulator',
            'integration_demo_lims_simulator'
          ] &&
          (
            !exists(
              /databases/$(database)/documents/workspaces/$(workspaceId)/integrations/$(integrationId)
            ) ||
            validStaffSafeDemoIntegration(
              resource.data,
              workspaceId,
              integrationId
            )
          );
        // The frozen two-document catalogue is fetched only by exact paths.
        // Every collection read remains closed for all client roles.
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /integrationSecrets/{document=**} {
        // Provider endpoints and Secret Manager references are server-only.
        // No actual token, key, certificate or secret belongs in Firestore.
        allow get, list, create, update, delete: if false;
      }

      match /usageLedger/{ledgerId} {
        allow read: if hasRole(workspaceId, ['tenant_admin']) &&
          isSameWorkspace(resource.data, workspaceId) &&
          resource.data.id == ledgerId;
        allow create, update, delete: if false;
      }

      match /dailyMetrics/{metricId} {
        allow read: if isSameWorkspace(resource.data, workspaceId) &&
          resource.data.id == metricId &&
          hasRole(workspaceId, [
            'tenant_admin',
            'supervisor',
            'campaign_operator',
            'campaign_approver',
            'analyst',
            'privacy_reviewer'
          ]);
        allow create, update, delete: if false;
      }

      // Backend mutation idempotency evidence is never visible or writable to
      // a browser. Admin SDK services bypass Rules and must enforce their own
      // tenant, schema, expiry and replay policy.
      match /idempotencyKeys/{idempotencyKeyId} {
        allow read, write: if false;
      }

      match /auditEvents/{auditEventId} {
        allow get: if canGetAuditEvent(
          workspaceId,
          resource.data,
          auditEventId
        );
        allow list: if false;

        // Server-only is safer than accepting client-authored audit evidence.
        allow create, update, delete: if false;
      }

      // Unknown workspace subcollections are denied explicitly.
      match /{unknownPath=**} {
        allow read, write: if false;
      }
    }

    // Global provider routing, webhook receipts, locks and platform audit are
    // server-only. The Admin SDK is not governed by these Rules.
    match /phoneRoutes/{document=**} {
      allow read, write: if false;
    }

    match /wabaRoutes/{document=**} {
      allow read, write: if false;
    }

    match /webhookEvents/{document=**} {
      allow read, write: if false;
    }

    match /jobLocks/{document=**} {
      allow read, write: if false;
    }

    match /platformAudit/{document=**} {
      allow read, write: if false;
    }

    // Default deny for every path not enumerated above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
