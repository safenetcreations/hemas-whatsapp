# Safe defaults: simulator-only, no provider or outbound network access.
HEMAS_RUNTIME_MODE=demo
HEMAS_DEFAULT_TENANT_ID=workspace_safenet_demo
HEMAS_PROVIDER_MODE=synthetic
HEMAS_INTEGRATION_MODE=synthetic
HEMAS_AUDIT_SINK_MODE=memory
# `durable` still fails closed unless code explicitly injects an approved sink.
# The concrete demo factory accepts only demo-hemas-connect plus a loopback
# FIRESTORE_EMULATOR_HOST; it cannot target a cloud project.
HEMAS_OUTBOUND_ENABLED=false
HEMAS_APPROVAL_GATE_REQUIRED=true
HEMAS_DIAGNOSIS_ENABLED=false
HEMAS_SYNTHETIC_SEED=hemas-connect-demo-v1

# Public test fixture material for the emulator-only synthetic ingress. This is
# intentionally not a secret and must never be reused for Meta, UAT or live.
HEMAS_SYNTHETIC_INGRESS_SECRET=PUBLIC-SYNTHETIC-WEBHOOK-FIXTURE-NOT-A-SECRET-2026

# Governed Meta canary defaults. Copy these names into a local ignored file or
# the approved deployment environment; never commit asset IDs or recipients.
HEMAS_CLOUD_DEMO_ENABLED=false
HEMAS_META_CANARY_ENABLED=false
HEMAS_META_PHONE_NUMBER_ID=
HEMAS_META_WABA_ID=
HEMAS_META_ALLOWLISTED_RECIPIENTS=
# Public inbound is a separate, exact opt-in. It never widens proactive
# templates, campaigns, or operator sends beyond the allowlist above. Public
# unknown free text may use the governed in-memory AI answerer when the global
# AI flag is enabled; questions/answers remain transient and model calls are
# bounded by separate sender/global public quotas.
HEMAS_META_PUBLIC_INBOUND_ENABLED=false
# Required 13-digit epoch-millisecond kill switch. A public test window is
# accepted only while this is in the future and no more than seven days away.
HEMAS_META_PUBLIC_INBOUND_EXPIRES_AT_MS=
# Current version in the HEMAS_META_RETURN_ROUTE_KEYRING Secret Manager value.
# The secret is strict JSON mapping up to four versions to canonical-base64
# 32-byte AES keys, for example {"1":"..."}. Keep old keys for at least seven
# days after rotation so queued routes can recover.
HEMAS_META_RETURN_ROUTE_KEY_VERSION=1
# HEMAS_META_PUBLIC_IDENTITY_KEY is a separate canonical-base64 32-byte Secret
# Manager value. It keys receipt, quota, session, and STOP identities and must
# remain stable. To replace it, first disable public mode, drain/expire routes,
# and governed-clean all public receipts, effects, sessions, and suppressions.
HEMAS_META_GRAPH_VERSION=v23.0
HEMAS_META_AUTO_REPLY_ENABLED=false
HEMAS_META_BOT_ENABLED=false
HEMAS_META_WELCOME_MEDIA_ID=
HEMAS_META_AI_ENABLED=false
HEMAS_GEMINI_MODEL=gemini-3.6-flash

# Future live activation metadata. These values do not enable a live adapter;
# no live provider implementation exists in this skeleton.
# HEMAS_LIVE_ACTIVATION_ID=
# HEMAS_LIVE_ACTIVATION_APPROVED_BY=
# HEMAS_LIVE_ACTIVATION_EXPIRES_AT=
