{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.hemas-connect.example/schemas/reply-callback-event.schema.json",
  "title": "whatsapp.reply.v1 callback event",
  "description": "Inbound reply webhook sent to the configured replyUrl. Signed identically to DLR events. Content-free by default: text is non-null only when the governed protected-inbox policy allows it (public inbound OFF and the sender is an allowlisted tester). conversationKey is a stable opaque key, never a phone number.",
  "type": "object",
  "required": ["event", "eventId", "occurredAtMs", "data"],
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "whatsapp.reply.v1"
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{32}$"
    },
    "occurredAtMs": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "object",
      "required": ["conversationKey", "senderLast4", "messageType", "text"],
      "additionalProperties": false,
      "properties": {
        "conversationKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{10}$"
        },
        "senderLast4": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "messageType": {
          "type": "string",
          "pattern": "^[a-z_]{2,32}$"
        },
        "text": {
          "type": ["string", "null"],
          "maxLength": 1024
        }
      }
    }
  }
}
