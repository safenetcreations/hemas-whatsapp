{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.hemas-connect.example/schemas/dlr-callback-event.schema.json",
  "title": "whatsapp.dlr.v1 callback event",
  "description": "Delivery status webhook sent to the configured dlrUrl. Signed with HMAC-SHA256 over '{timestampMs}.{eventId}.{rawBody}' (X-Hemas-Signature-256: sha256=<hex>). Deduplicate on eventId; status only advances sent -> delivered -> read, failed is terminal. clientReference echoes the exact key supplied on the bulk item (custom-key recovery).",
  "type": "object",
  "required": ["event", "eventId", "occurredAtMs", "data"],
  "additionalProperties": false,
  "properties": {
    "event": {
      "const": "whatsapp.dlr.v1"
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{32}$"
    },
    "occurredAtMs": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "object",
      "required": [
        "clientBatchId",
        "clientReference",
        "providerMessageId",
        "status",
        "recipientLast4"
      ],
      "additionalProperties": false,
      "properties": {
        "clientBatchId": {
          "type": "string"
        },
        "clientReference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "providerMessageId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 512
        },
        "status": {
          "enum": ["sent", "delivered", "read", "failed"]
        },
        "recipientLast4": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        }
      }
    }
  }
}
